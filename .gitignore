# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.venv/
venv/
.env/

# Outputs and local data
data/inputs/
data/outputs/

# User config/preset store (regenerated from built-in seeds on first run)
preferences.json

# Audio files
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac

*.mov
*.mp4
*.avi

# OS files
.DS_Store
Thumbs.db

# Ignore .claude contents (local settings), but keep the skills — they're part
# of the tool and need to travel with the repo. Note this excludes the *entries
# inside* .claude rather than .claude itself: git won't re-include anything
# under a directory it has already excluded.
.claude/*
!.claude/skills/

# Clipper engine. Projects normally live beside their media (an episode's
# clipper/ folder), so what's here is just the id -> directory index plus the
# fallback location used when cameras span different drives.
clipper_projects.json
/projects/
# Graphics renderer (Remotion). node_modules is `npm install` in graphics/;
# _assets is images staged for a render, copied from wherever they live.
graphics/node_modules/
graphics/public/_assets/
# Everything under graphics/src/ but the engine's own files is generated: show
# components copied in by graphics/sync-shows.mjs (src/<show>/, src/_shows.ts)
# and an episode's scenes copied in by skleyka/render.py (src/_episode/).
/graphics/src/*
!/graphics/src/Root.tsx
!/graphics/src/index.ts
!/graphics/src/theme.tsx
!/graphics/src/templates/
!/graphics/src/panel/
# Fonts the renderer serves: only the free ones are the engine's; a show's
# licensed faces are synced in from shows/ and stay out of git.
/graphics/public/fonts/*
!/graphics/public/fonts/BebasNeue-Regular.ttf
!/graphics/public/fonts/Montserrat-VariableFont_wght.ttf

# The client tier: one folder per show (its own private repo), see
# caption_engine/shows.py. Only the README describing the layout is public.
/shows/*
!/shows/README.md

# Remotion's downloaded headless Chrome (~270 MB), re-fetched on demand
.remotion/
