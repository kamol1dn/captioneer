<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gashtak Skleyka bridge. Forked from the CEP connector of premiere-pro-mcp
  (MIT, see LICENSE-premiere-pro-mcp) and cut down to the file bridge alone.

  Two extensions share one main.js: the headless one starts with Premiere and
  runs the bridge, so nothing has to be opened by hand; the panel only shows
  the bridge's heartbeat and log.
-->
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.gashtak.skleyka"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Gashtak Skleyka"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.gashtak.skleyka.headless" Version="0.1.0"/>
    <Extension Id="com.gashtak.skleyka.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="15.0"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.gashtak.skleyka.headless">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <Extension Id="com.gashtak.skleyka.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Gashtak Skleyka</Menu>
          <Geometry>
            <Size><Height>260</Height><Width>360</Width></Size>
            <MinSize><Height>120</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
